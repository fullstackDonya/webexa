DB_PORT=3306
DB_NAME=webexa
DB_USER=siteo_user
DB_PASSWORD=%la_vie_un_urshad_kaleel.199010/%


# API Configuration (VPS - écouter sur 127.0.0.1 seulement, Nginx reverse proxy de l'extérieur)
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=bDVQoVSdFU0UN7Z1xLlWDH7eRV6Yor2dOI-fgUj3Cps  # ⚠️ Même clé que dans le CRM PHP sur Hostinger

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=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
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Chemins de stockage
VECTOR_DB_PATH=/var/www/webexa-ai/agents-ia/data/chromadb
LOG_FILE=/var/www/webexa-ai/agents-ia/logs/agents.log

# Redis (optionnel - pour cache et queues)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Agents - Activation
INBOX_AGENT_ENABLED=true
WHATSAPP_AGENT_ENABLED=false
LEAD_AGENT_ENABLED=true
CAMPAIGN_AGENT_ENABLED=true
MISSION_AGENT_ENABLED=false
SCHEDULER_AGENT_ENABLED=true
EXECUTOR_AGENT_ENABLED=false

# Mode d'automatisation
# - assisted: L'IA propose, l'humain valide
# - semi-auto: Automatique pour tâches simples, validation pour complexes
# - autonomous: Totalement automatique (DANGEREUX en production !)
AUTOMATION_MODE=assisted

# Email Processing
EMAIL_BATCH_SIZE=20
EMAIL_PROCESS_INTERVAL=300

# Environnement
ENV=production
