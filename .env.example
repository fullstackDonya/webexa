# ===========================================
# CRM - EMAIL INTEGRATION ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ----- ENCRYPTION -----
# Master encryption key for email credentials and OAuth tokens
# Generate with: php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;"
MAIL_CRYPTO_KEY=

# ----- DATABASE -----
DB_HOST=localhost
DB_NAME=webexa
DB_USER=root
DB_PASS=root

# ----- GOOGLE OAUTH (Gmail API) -----
# Create project: https://console.cloud.google.com
# Enable Gmail API
# Configure OAuth consent screen
# Create OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development: http://localhost/crm/oauth/google/callback
# Production: https://webitech.fr/crm/oauth/google/callback
GOOGLE_REDIRECT_URI=https://webitech.fr/crm/oauth/google/callback

# Gmail API Scopes (space-separated)
# Recommended minimal scopes:
GOOGLE_SCOPES='https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.modify
'
# Gmail Push Notifications (optional but recommended)
# Create Pub/Sub topic in Google Cloud
# Grant Gmail publish permissions
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PROJECT_ID=

# ----- MICROSOFT OAUTH (Outlook/Office 365) -----
# Register app: https://portal.azure.com
# Configure multi-tenant if needed
# Add redirect URI
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Development: http://localhost/crm/oauth/microsoft/callback
# Production: https://webitech.fr/crm/oauth/microsoft/callback
MICROSOFT_REDIRECT_URI=https://webitech.fr/crm/oauth/microsoft/callback
MICROSOFT_TENANT=common

# Microsoft Graph Scopes (space-separated)
# Recommended minimal scopes:
MICROSOFT_SCOPES='offline_access Mail.Read Mail.Send Mail.ReadWrite'

# ----- WHATSAPP BUSINESS (Meta Cloud API) -----
# Create app: https://developers.facebook.com/apps
# Add WhatsApp product
# Each customer connects their WhatsApp Business number
# Get permanent access token: https://developers.facebook.com/docs/whatsapp/business-management-api/get-started
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Webhook callback URL (configure in Meta App Dashboard)
# Development: http://localhost/crm/webhooks/whatsapp.php
# Production: https://webitech.fr/crm/webhooks/whatsapp.php
WHATSAPP_WEBHOOK_URL=https://webitech.fr/crm/webhooks/whatsapp.php

# WhatsApp Cloud API Version
WHATSAPP_API_VERSION=v18.0

# WhatsApp sender (optional - for testing only)
# In production, each customer uses their own phone_number_id
WHATSAPP_TEST_PHONE_NUMBER_ID=

# ----- REDIS (for job queue and caching) -----
# Install Redis: brew install redis (macOS) or apt-get install redis (Linux)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----- EMAIL SYNC SETTINGS -----
# How often to sync emails (in seconds)
EMAIL_SYNC_INTERVAL=300

# Max emails to fetch per sync
EMAIL_SYNC_LIMIT=50

# Enable background workers
EMAIL_WORKERS_ENABLED=true

# Number of concurrent worker processes
EMAIL_WORKER_COUNT=2

# ----- RATE LIMITING -----
# Gmail API: 250 quota units/user/second, 1 billion/day
GMAIL_RATE_LIMIT_PER_MINUTE=60

# Microsoft Graph: varies by endpoint
MICROSOFT_RATE_LIMIT_PER_MINUTE=60

# IMAP connections per account (max simultaneous)
IMAP_MAX_CONNECTIONS=1

# ----- WEBHOOK SECURITY -----
# Secret for validating webhook requests
WEBHOOK_SECRET=

# ----- LOGGING & MONITORING -----
# Log level: debug, info, warning, error
# Development: debug | Production: warning ou error
LOG_LEVEL=warning

# Log file location
# Development: /Applications/MAMP/htdocs/PP/webitech/WEB/crm/logs/email.log
# Production: /var/www/webitech/crm/logs/email.log ou /home/webitech/crm/logs/email.log
LOG_FILE=/var/www/webitech/crm/logs/email.log

# Enable detailed OAuth debug logs (development only - DISABLE IN PRODUCTION)
OAUTH_DEBUG=false

# ----- APPLICATION -----
# Development: http://localhost
# Production: https://webitech.fr
APP_URL=https://webitech.fr
# Environment: development | production | staging
APP_ENV=production

# ----- OPTIONAL: KMS INTEGRATION -----
# For production, use AWS KMS or Google Cloud KMS
# KMS_PROVIDER=aws|gcp
# KMS_KEY_ID=
# AWS_REGION=
# GCP_PROJECT=
